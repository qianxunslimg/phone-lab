export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="ys"
zstyle ':omz:update' mode disabled

plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  z
  extract
  web-search
  copyfile
  copypath
)

source $ZSH/oh-my-zsh.sh

export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export EDITOR=vim

alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias bat='cat /sys/class/power_supply/battery/capacity /sys/class/power_supply/battery/status /sys/class/power_supply/battery/temp 2>/dev/null'
